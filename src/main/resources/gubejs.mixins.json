{
  "required": true,
  "minVersion": "0.8",
  "package": "com.github.gubejs.mixin",
  "compatibilityLevel": "JAVA_17",
  "refmap": "gubejs.refmap.json",
  "mixins": [
    "BlockBehaviourAccessor",
    "BlockBehaviourMixin",
    "BlockMixin",
    "BlockStateBaseAccessor",
    "EntityMixin",
    "InventoryMixin",
    "ItemMixin",
    "ItemStackMixin",
    "LevelMixin",
    "LootTablesMixin",
    "MinecraftServerMixin",
    "PlayerAdvancementsMixin",
    "PlayerMixin",
    "RecipeManagerMixin",
    "ReloadableServerResourcesMixin",
    "TagLoaderMixin"
  ],
  "client": [
    "client.ClientLanguageMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  },
  "overwrites": {
    "requireAnnotations": true
  }
}
